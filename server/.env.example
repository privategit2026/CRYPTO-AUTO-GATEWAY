# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Database ───────────────────────────────────────────────────────────────
# Example: postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cryptogate?schema=public

# ─── Redis (cache / queue) ──────────────────────────────────────────────────
# Optional in dev. If omitted the app still boots but caching is disabled.
REDIS_URL=redis://localhost:6379

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-please-make-a-long-random-string
JWT_REFRESH_SECRET=change-me-too-please-make-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of origins the frontend will run on.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ─── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ─── Seed ───────────────────────────────────────────────────────────────────
# Default password for seeded users (login with email + this).
SEED_DEFAULT_PASSWORD=Password123!
