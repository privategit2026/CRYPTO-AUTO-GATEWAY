// Crypto Gateway — PostgreSQL schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum WalletStatus {
  ACTIVE
  USED
  INACTIVE
  ARCHIVED
}

enum DepositStatus {
  PENDING
  DETECTED
  CONFIRMING
  COMPLETED
  FAILED
  EXPIRED
}

/// Supported EVM / TRON-style networks for USDT and automation hooks.
enum CryptoNetwork {
  TRC20
  ERC20
  BEP20
  POLYGON
  ARBITRUM
  OPTIMISM
  BASE
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ApiKeyPermission {
  READ
  WRITE
  WEBHOOKS
}

enum ActivityCategory {
  DEPOSIT
  WALLET
  USER
  API
  SYSTEM
  SECURITY
}

enum ActivitySeverity {
  INFO
  WARNING
  ERROR
  SUCCESS
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id     String     @id @default(cuid())
  email  String     @unique
  name   String
  role   UserRole   @default(VIEWER)
  status UserStatus @default(ACTIVE)

  /// Merchant / workspace display name (API key “merchant” label).
  companyName String?

  /// Future auth / profile
  phone           String?
  avatarUrl       String?
  passwordHash    String?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  /// External IdP / billing linkage
  externalId String? @unique
  metadata   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallets          Wallet[]
  deposits         Deposit[]
  apiKeys          ApiKey[]
  activityAsActor  ActivityLog[] @relation("ActivityActor")
  activityAsTarget ActivityLog[] @relation("ActivityTarget")

  @@index([status, createdAt])
  @@index([role, status])
}

model Wallet {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Normalized on-chain address (lowercase for EVM where applicable).
  address String
  network CryptoNetwork
  status  WalletStatus  @default(ACTIVE)

  label String?

  /// HD / automation (optional)
  derivationPath String?
  addressIndex   Int?
  isWatchOnly    Boolean @default(false)

  /// Sync & token automation
  lastSyncedBlock      BigInt?
  lastSyncedAt         DateTime?
  /// USDT/USDC contract on this network when applicable.
  tokenContractAddress String?
  /// Raw provider payload, webhook ids, etc.
  automationMetadata   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deposits     Deposit[]
  activityLogs ActivityLog[]

  @@unique([network, address])
  @@index([userId, status])
  @@index([network, status])
  @@index([userId, network])
}

model Deposit {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  walletId String?
  wallet   Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  /// Amount in smallest display unit or main unit — keep consistent app-wide (here: main unit, e.g. USDT).
  amount      Decimal       @db.Decimal(38, 18)
  assetSymbol String        @default("USDT")
  network     CryptoNetwork
  /// Destination / watched address for this payment.
  toAddress   String
  /// On-chain transaction id (EVM: 0x…, TRON: hex).
  txHash      String?

  status                DepositStatus @default(PENDING)
  confirmations         Int           @default(0)
  requiredConfirmations Int?

  detectedAt  DateTime?
  completedAt DateTime?
  /// Payment window / invoice expiry.
  expiresAt   DateTime?

  /// Merchant order / invoice id for callbacks.
  externalOrderId String?
  /// Idempotent create from API.
  idempotencyKey  String? @unique

  /// Callback queue, raw node payloads, reconciliation flags.
  rawPayload         Json?
  automationMetadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityLogs ActivityLog[]

  @@unique([network, txHash])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([network, status])
  @@index([externalOrderId])
}

model ApiKey {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  /// First chars shown in UI (e.g. pk_live_xxxx…).
  keyPrefix  String
  /// Lookup hash of full public key (never store raw key).
  keyHash    String @unique
  /// bcrypt/argon hash of secret.
  secretHash String

  permissions ApiKeyPermission[]
  status      ApiKeyStatus       @default(ACTIVE)

  rateLimitPerMin Int @default(5000)
  requestsToday   Int @default(0)

  lastUsedAt    DateTime?
  expiresAt     DateTime?
  lastRequestIp String?

  rotatedFromId String?
  rotatedFrom   ApiKey?  @relation("ApiKeyRotation", fields: [rotatedFromId], references: [id], onDelete: SetNull)
  rotatedTo     ApiKey[] @relation("ApiKeyRotation")

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityLogs ActivityLog[]

  @@index([userId, status])
  @@index([status, expiresAt])
}

model ActivityLog {
  id String @id @default(cuid())

  action      String
  category    ActivityCategory
  description String           @db.Text
  severity    ActivitySeverity @default(INFO)

  /// Who performed the action (null = system/cron).
  actorUserId String?
  actorUser   User?   @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  /// Denormalized label when actor is system (“System”, “Unknown”).
  actorLabel  String?

  ipAddress String?
  userAgent String?

  targetUserId String?
  targetUser   User?   @relation("ActivityTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  depositId String?
  deposit   Deposit? @relation(fields: [depositId], references: [id], onDelete: SetNull)

  walletId String?
  wallet   Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  apiKeyId String?
  apiKey   ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  requestId String?
  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, createdAt(sort: Desc)])
  @@index([severity, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}
